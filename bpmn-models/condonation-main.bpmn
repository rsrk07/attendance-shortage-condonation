<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_condonation_main" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="attendance-shortage-condonation" name="Attendance Shortage Condonation" isExecutable="true">
    <bpmn:startEvent id="Start_Submitted" name="Condonation request submitted">
      <bpmn:outgoing>Flow_Main_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_FetchAttendance" name="Fetch attendance record" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="=&#34;https://raw.githubusercontent.com/rsrk07/attendance-shortage-condonation/main/backend-springboot/src/main/resources/data/attendance/&#34; + studentId + &#34;.json&#34;" target="url" />
          <zeebe:input source="false" target="followRedirects" />
          <zeebe:input source="JSON" target="documentReturnFormat.choice" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="18" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={attendanceRecord: response.body}" />
          <zeebe:header key="errorExpression" value="=if error != null and error.code = &#34;404&#34; then bpmnError(&#34;STUDENT_NOT_FOUND&#34;, &#34;No attendance record found for this student&#34;) else null" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Main_01</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_StudentNotFound" name="Not found (404)" attachedToRef="Task_FetchAttendance">
      <bpmn:outgoing>Flow_ToStudentNotFound</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_StudentNotFound" errorRef="Error_StudentNotFound" />
    </bpmn:boundaryEvent>
    <bpmn:scriptTask id="Task_CalculateShortfall" name="Calculate attendance &amp; shortfall">
      <bpmn:extensionElements>
        <zeebe:script expression="={record: attendanceRecord.courses[code = courseCode][1], courseName: record.name, attended: record.attended, conducted: record.conducted, percentage: decimal(record.attended / record.conducted * 100, 2), shortfall: decimal(max(75 - percentage, 0), 2)}" resultVariable="attendance" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Main_02</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_03</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="Task_DecideEligibility" name="Decide eligibility slab &amp; fee">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="condonation-eligibility" resultVariable="eligibility" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Main_03</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_04</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Condonable" name="Condonable?" default="Flow_NotCondonable">
      <bpmn:incoming>Flow_Main_04</bpmn:incoming>
      <bpmn:outgoing>Flow_Condonable</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotCondonable</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess_Documents" name="Collect &amp; verify documents">
      <bpmn:incoming>Flow_Condonable</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_05</bpmn:outgoing>
      <bpmn:startEvent id="Start_Docs" name="Documents requested">
        <bpmn:outgoing>Flow_Docs_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask_UploadDocuments" name="Upload supporting documents">
        <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="upload-documents" />
        <zeebe:assignmentDefinition assignee="=studentId" candidateGroups="students" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Docs_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Docs_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="Task_ValidateDocument" name="Validate document">
        <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-document" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Docs_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Docs_3</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=documents" inputElement="document" outputCollection="documentChecks" outputElement="=documentCheck" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_DocsVerified" name="Documents verified">
        <bpmn:incoming>Flow_Docs_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Docs_1" sourceRef="Start_Docs" targetRef="UserTask_UploadDocuments" />
      <bpmn:sequenceFlow id="Flow_Docs_2" sourceRef="UserTask_UploadDocuments" targetRef="Task_ValidateDocument" />
      <bpmn:sequenceFlow id="Flow_Docs_3" sourceRef="Task_ValidateDocument" targetRef="End_DocsVerified" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_DocsTimeout" name="Deadline passed" attachedToRef="SubProcess_Documents">
      <bpmn:outgoing>Flow_ToDocsNotSubmitted</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Docs">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=documentDeadline</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_DocInvalid" name="Invalid document" attachedToRef="SubProcess_Documents">
      <bpmn:outgoing>Flow_ToDocsInvalid</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_DocInvalid" errorRef="Error_DocInvalid" />
    </bpmn:boundaryEvent>
    <bpmn:callActivity id="CallActivity_Approval" name="Approval by required approvers">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="condonation-approval" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:output source="=approval" target="approval" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Main_05</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_06</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=eligibility.approvers" inputElement="approverRole" outputCollection="approvals" outputElement="=approval" />
        </bpmn:extensionElements>
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">=approval.approved = false</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_AllApproved" name="All approved?" default="Flow_ApprovalRejected">
      <bpmn:incoming>Flow_Main_06</bpmn:incoming>
      <bpmn:outgoing>Flow_AllApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovalRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess_Fee" name="Fee payment">
      <bpmn:incoming>Flow_AllApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_07</bpmn:outgoing>
      <bpmn:startEvent id="Start_Fee" name="Fee requested">
        <bpmn:outgoing>Flow_Fee_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask_PayFee" name="Pay condonation fee">
        <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="pay-fee" />
        <zeebe:assignmentDefinition assignee="=studentId" candidateGroups="students" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Fee_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Fee_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="Task_VerifyPayment" name="Verify payment">
        <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-payment" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Fee_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Fee_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_FeePaid" name="Fee paid">
        <bpmn:incoming>Flow_Fee_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Fee_1" sourceRef="Start_Fee" targetRef="UserTask_PayFee" />
      <bpmn:sequenceFlow id="Flow_Fee_2" sourceRef="UserTask_PayFee" targetRef="Task_VerifyPayment" />
      <bpmn:sequenceFlow id="Flow_Fee_3" sourceRef="Task_VerifyPayment" targetRef="End_FeePaid" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_FeeTimeout" name="Fee deadline passed" attachedToRef="SubProcess_Fee">
      <bpmn:outgoing>Flow_ToFeeNotPaid</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Fee">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=feeDeadline</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_PaymentInvalid" name="Payment invalid" attachedToRef="SubProcess_Fee">
      <bpmn:outgoing>Flow_ToPaymentInvalid</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_PaymentInvalid" errorRef="Error_PaymentInvalid" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_SisRetry">
      <bpmn:incoming>Flow_Main_07</bpmn:incoming>
      <bpmn:incoming>Flow_SisRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_UpdateSIS" name="Update SIS record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-sis-record" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Main_08</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_SisFailed" name="SIS update failed" attachedToRef="Task_UpdateSIS">
      <bpmn:outgoing>Flow_SisFailed</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_SisFailed" errorRef="Error_SisFailed" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="UserTask_AdminFix" name="Fix SIS record (admin)">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="admin-fix" />
        <zeebe:assignmentDefinition candidateGroups="admin" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SisFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_SisRetry</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_SplitApproved">
      <bpmn:incoming>Flow_Main_09</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_Main_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="CallActivity_NotifyApproved" name="Notify student (approved)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=studentEmail" target="emailTo" />
          <zeebe:input source="=&#34;Attendance condonation approved - &#34; + courseCode" target="emailSubject" />
          <zeebe:input source="=&#34;Dear &#34; + studentName + &#34;,\n\nYour attendance condonation request for &#34; + courseCode + &#34; (&#34; + attendance.courseName + &#34;) has been approved.\n\nAttendance: &#34; + string(attendance.percentage) + &#34;%\nSlab: &#34; + eligibility.slab + &#34;\nFee paid: Rs. &#34; + string(eligibility.fee) + &#34;\n\nYour record has been updated in the Student Information System.\n\nRegards,\nAcademic Office&#34;" target="emailBody" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Main_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_12</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="Task_RecordApproved" name="Record outcome (approved)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-outcome" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;APPROVED&#34;" target="outcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Main_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_JoinApproved">
      <bpmn:incoming>Flow_Main_12</bpmn:incoming>
      <bpmn:incoming>Flow_Main_13</bpmn:incoming>
      <bpmn:outgoing>Flow_Main_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_Condoned" name="Attendance condoned">
      <bpmn:incoming>Flow_Main_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="Event_StudentNotFound" name="Student record not found">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;No attendance record was found for student &#34; + studentId + &#34;.&#34;" target="rejectionReason" />
          <zeebe:output source="=&#34;ATTENDANCE&#34;" target="rejectionStage" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToStudentNotFound</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_1</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_NotCondonable" name="Not condonable">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=if attendance.percentage = null then &#34;Course &#34; + courseCode + &#34; was not found in your attendance record.&#34; else if attendance.percentage &gt;= 75 then &#34;Your attendance in &#34; + courseCode + &#34; is &#34; + string(attendance.percentage) + &#34;%, so condonation is not required.&#34; else &#34;Your attendance in &#34; + courseCode + &#34; is &#34; + string(attendance.percentage) + &#34;%, which is below the condonable limit for your reason category.&#34;" target="rejectionReason" />
          <zeebe:output source="=&#34;ELIGIBILITY&#34;" target="rejectionStage" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotCondonable</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_2</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_DocsNotSubmitted" name="Documents not submitted">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;Supporting documents were not submitted before the deadline.&#34;" target="rejectionReason" />
          <zeebe:output source="=&#34;DOCUMENTS&#34;" target="rejectionStage" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDocsNotSubmitted</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_3</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_DocsInvalid" name="Documents rejected">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;A supporting document was rejected: &#34; + (if documentRejectionNote = null then &#34;verification failed&#34; else documentRejectionNote)" target="rejectionReason" />
          <zeebe:output source="=&#34;DOCUMENTS&#34;" target="rejectionStage" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDocsInvalid</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_4</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_ApprovalRejected" name="Rejected by approver">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="={rejected: approvals[item != null and item.approved = false][1], reason: if rejected = null then &#34;The request was not approved.&#34; else &#34;Rejected by &#34; + rejected.role + (if rejected.remarks = &#34;&#34; then &#34;.&#34; else &#34;: &#34; + rejected.remarks)}.reason" target="rejectionReason" />
          <zeebe:output source="=&#34;APPROVAL&#34;" target="rejectionStage" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApprovalRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_5</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_FeeNotPaid" name="Fee not paid">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;The condonation fee of Rs. &#34; + string(eligibility.fee) + &#34; was not paid before the deadline.&#34;" target="rejectionReason" />
          <zeebe:output source="=&#34;FEE&#34;" target="rejectionStage" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFeeNotPaid</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_6</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_PaymentInvalid" name="Payment rejected">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;The fee payment could not be verified: &#34; + (if paymentRejectionNote = null then &#34;invalid payment details&#34; else paymentRejectionNote)" target="rejectionReason" />
          <zeebe:output source="=&#34;FEE&#34;" target="rejectionStage" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPaymentInvalid</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_7</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_RejectMerge">
      <bpmn:incoming>Flow_Reject_1</bpmn:incoming>
      <bpmn:incoming>Flow_Reject_2</bpmn:incoming>
      <bpmn:incoming>Flow_Reject_3</bpmn:incoming>
      <bpmn:incoming>Flow_Reject_4</bpmn:incoming>
      <bpmn:incoming>Flow_Reject_5</bpmn:incoming>
      <bpmn:incoming>Flow_Reject_6</bpmn:incoming>
      <bpmn:incoming>Flow_Reject_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_Notify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="CallActivity_NotifyRejected" name="Notify student (rejected)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=studentEmail" target="emailTo" />
          <zeebe:input source="=&#34;Attendance condonation request &#34; + string(requestId) + &#34; - not approved&#34;" target="emailSubject" />
          <zeebe:input source="=&#34;Dear &#34; + studentName + &#34;,\n\nYour attendance condonation request for &#34; + courseCode + &#34; could not be approved.\n\nReason: &#34; + rejectionReason + &#34;\n\nRegards,\nAcademic Office&#34;" target="emailBody" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reject_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_Record</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="Task_RecordRejected" name="Record outcome (rejected)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-outcome" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;REJECTED&#34;" target="outcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reject_Record</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Rejected" name="Request rejected">
      <bpmn:incoming>Flow_Reject_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Main_01" sourceRef="Start_Submitted" targetRef="Task_FetchAttendance" />
    <bpmn:sequenceFlow id="Flow_Main_02" sourceRef="Task_FetchAttendance" targetRef="Task_CalculateShortfall" />
    <bpmn:sequenceFlow id="Flow_Main_03" sourceRef="Task_CalculateShortfall" targetRef="Task_DecideEligibility" />
    <bpmn:sequenceFlow id="Flow_Main_04" sourceRef="Task_DecideEligibility" targetRef="Gateway_Condonable" />
    <bpmn:sequenceFlow id="Flow_Condonable" name="Yes" sourceRef="Gateway_Condonable" targetRef="SubProcess_Documents">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligibility.condonable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Main_05" sourceRef="SubProcess_Documents" targetRef="CallActivity_Approval" />
    <bpmn:sequenceFlow id="Flow_Main_06" sourceRef="CallActivity_Approval" targetRef="Gateway_AllApproved" />
    <bpmn:sequenceFlow id="Flow_AllApproved" name="Yes" sourceRef="Gateway_AllApproved" targetRef="SubProcess_Fee">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=every a in approvals satisfies a.approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Main_07" sourceRef="SubProcess_Fee" targetRef="Gateway_SisRetry" />
    <bpmn:sequenceFlow id="Flow_Main_08" sourceRef="Gateway_SisRetry" targetRef="Task_UpdateSIS" />
    <bpmn:sequenceFlow id="Flow_SisFailed" sourceRef="Boundary_SisFailed" targetRef="UserTask_AdminFix" />
    <bpmn:sequenceFlow id="Flow_SisRetry" name="Retry" sourceRef="UserTask_AdminFix" targetRef="Gateway_SisRetry" />
    <bpmn:sequenceFlow id="Flow_Main_09" sourceRef="Task_UpdateSIS" targetRef="Gateway_SplitApproved" />
    <bpmn:sequenceFlow id="Flow_Main_10" sourceRef="Gateway_SplitApproved" targetRef="CallActivity_NotifyApproved" />
    <bpmn:sequenceFlow id="Flow_Main_11" sourceRef="Gateway_SplitApproved" targetRef="Task_RecordApproved" />
