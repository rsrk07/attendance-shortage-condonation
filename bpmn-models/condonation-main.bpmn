    <bpmn:sequenceFlow id="Flow_Main_14" sourceRef="CallActivity_InformApprovers" targetRef="Gateway_JoinApproved" />
    <bpmn:sequenceFlow id="Flow_Main_15" sourceRef="Task_RecordApproved" targetRef="Gateway_JoinApproved" />
    <bpmn:sequenceFlow id="Flow_Main_16" sourceRef="Gateway_JoinApproved" targetRef="End_Condoned" />
    <bpmn:sequenceFlow id="Flow_ToStudentNotFound" sourceRef="Boundary_StudentNotFound" targetRef="Event_StudentNotFound" />
    <bpmn:sequenceFlow id="Flow_NotCondonable" name="No" sourceRef="Gateway_Condonable" targetRef="Event_NotCondonable" />
    <bpmn:sequenceFlow id="Flow_ToDocsInvalid" sourceRef="Boundary_DocInvalid" targetRef="Event_DocsInvalid" />
    <bpmn:sequenceFlow id="Flow_ToFeeNotPaid" sourceRef="Boundary_FeeTimeout" targetRef="Event_FeeNotPaid" />
    <bpmn:sequenceFlow id="Flow_ToPaymentInvalid" sourceRef="Boundary_PaymentInvalid" targetRef="Event_PaymentInvalid" />
    <bpmn:sequenceFlow id="Flow_Reject_1" sourceRef="Event_StudentNotFound" targetRef="Gateway_RejectMerge" />
    <bpmn:sequenceFlow id="Flow_Reject_2" sourceRef="Event_NotCondonable" targetRef="Gateway_RejectMerge" />
