# Copy this file to .env and fill in your own values.
# .env is git-ignored - never commit real credentials.

# --- Camunda 8 SaaS (Console -> Organization -> API -> Create client, scope "Orchestration Cluster API") ---
CAMUNDA_CLUSTER_ID=750197dc-11f7-4cb3-991f-2df490c7664a
CAMUNDA_REGION=sin-1
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=

# Deploy bpmn-models/ (BPMN, DMN, forms) to the cluster when the backend starts
DEPLOY_ON_STARTUP=true

# --- Demo login (all demo users share this password) ---
DEMO_PASSWORD=demo123

# --- E-mail recipients (the e-mails themselves are sent by Camunda's Email connector;
#     SMTP_USERNAME / SMTP_PASSWORD are Camunda connector secrets, not set here) ---
# When set, every notification (student and approvers) goes to this one inbox - recommended for demos
NOTIFICATION_EMAIL=
FA_EMAIL=fa@example.com
AA_EMAIL=aa@example.com
HOD_EMAIL=hod@example.com

# --- Process timers (ISO-8601 durations). Short values make the timers visible in a demo. ---
FEE_DEADLINE=P7D
REMINDER_INTERVAL=PT24H

# Start new requests with a simulated SIS failure (admin can also toggle this in the app)
SIMULATE_SIS_FAILURE=false
